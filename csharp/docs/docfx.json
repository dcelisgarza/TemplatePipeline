{
  "metadata": [
    {
      "src": [
        {
          "src": "../src/Shapes",
          "files": ["Shapes.csproj"]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      { "files": ["api/**.yml", "api/index.md"] },
      { "files": ["index.md", "toc.yml"] }
    ],
    "dest": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "shapes-csharp",
      "_appTitle": "shapes-csharp",
      "_enableSearch": true
    }
  }
}
